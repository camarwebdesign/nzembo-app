# Configuration unifiée Nzembo (copier vers .env pour le dev local, ou configurer sur Vercel Dashboard)
PORT=3000

# Base de données PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Supabase (Auth, Storage, Database)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Moteur Audio IA & Proxy
SUNO_BEARER_TOKEN="your_suno_bearer_token_here"
SUNO_API_KEY="your_suno_api_key_here"
MUSICGPT_API_KEY="your_musicgpt_api_key_here"

# Paiements SasPay
SASPAY_SECRET_KEY="your_saspay_secret_key_here"
SASPAY_API_BASE_URL="https://api.saspay.me/api/v1"
SASPAY_WEBHOOK_SECRET="your_saspay_webhook_signing_secret_here"

# URLs publiques de retour
APP_URL="https://app.nzembo.net"
BACKEND_PUBLIC_URL="https://nzembo.net"
BACKEND_URL=""
