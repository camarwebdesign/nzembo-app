{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/env.local.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.nzembo.net"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/((?!api/|env\\.local\\.js|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "app.nzembo.net"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.nzembo.com"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/((?!api/|env\\.local\\.js|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "app.nzembo.com"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.nzembo.net"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|env\\.local\\.js|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.nzembo.net"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.nzembo.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|env\\.local\\.js|.*\\..*).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.nzembo.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/((?!.*\\..*).*)",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/((?!.*\\..*).*)",
      "destination": "/admin.html"
    },
    {
      "source": "/invite/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    }
  ]
}
